{
  "manifest_version": 3,
  "name": "Browser Privacy Agent",
  "version": "1.0.0",
  "description": "Detects sensitive webpage elements locally.",
  "permissions": ["activeTab", "webNavigation"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rule.js", "context-rules.js","content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ocr-assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
